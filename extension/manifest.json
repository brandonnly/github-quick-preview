{
  "manifest_version": 2,
  "name": "GitHub Quick Preview",
  "version": "1.0.2",
  "author": "Brandon Ly",
  "homepage_url": "https://github.com/brandonnly/github-quick-preview",
  "description": "Preview GitHub PR screenshots in place. Use the arrow keys to browse and Escape to close.",
  "browser_specific_settings": {
    "gecko": {
      "id": "github-quick-preview@brandon.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["preview.js"],
      "run_at": "document_idle"
    }
  ]
}
